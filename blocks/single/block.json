{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hc-sermons/single",
	"title": "Sermon (Single)",
	"category": "hc-blocks",
	"icon": "format-video",
	"description": "Display a single sermon — most recent, by admin pick, or by latest in a series.",
	"textdomain": "hc-sermons",
	"attributes": {
		"selectionMode": {
			"type": "string",
			"default": "recent"
		},
		"sermonId": {
			"type": "number",
			"default": 0
		},
		"seriesId": {
			"type": "number",
			"default": 0
		},
		"showTitle": {
			"type": "boolean",
			"default": true
		},
		"showDate": {
			"type": "boolean",
			"default": true
		},
		"showSpeaker": {
			"type": "boolean",
			"default": true
		},
		"showScripture": {
			"type": "boolean",
			"default": true
		},
		"showDescription": {
			"type": "boolean",
			"default": false
		},
		"linkToSermon": {
			"type": "boolean",
			"default": true
		},
		"useContainer": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": ["wide", "full"]
	},
	"editorScript": "file:./index.js"
}
