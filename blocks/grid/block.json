{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hc-sermons/grid",
	"title": "Sermon Grid",
	"category": "hc-blocks",
	"icon": "grid-view",
	"description": "A grid of sermons with pagination. Clicking an item loads it into a Sermon Player (if present) and scrolls to it; each item also links to its own sermon page.",
	"textdomain": "hc-sermons",
	"attributes": {
		"source": {
			"type": "string",
			"default": "recent"
		},
		"seriesId": {
			"type": "number",
			"default": 0
		},
		"speakerId": {
			"type": "number",
			"default": 0
		},
		"pickedIds": {
			"type": "array",
			"default": []
		},
		"count": {
			"type": "number",
			"default": 12
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"orderBy": {
			"type": "string",
			"default": "preached"
		},
		"order": {
			"type": "string",
			"default": "DESC"
		},
		"showThumbnail": {
			"type": "boolean",
			"default": true
		},
		"showDate": {
			"type": "boolean",
			"default": true
		},
		"showSpeaker": {
			"type": "boolean",
			"default": false
		},
		"showSeries": {
			"type": "boolean",
			"default": false
		},
		"showScripture": {
			"type": "boolean",
			"default": false
		},
		"showPageLinks": {
			"type": "boolean",
			"default": false
		},
		"paginationEnabled": {
			"type": "boolean",
			"default": true
		},
		"autoplayOnSelect": {
			"type": "boolean",
			"default": true
		},
		"useContainer": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": ["wide", "full"]
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js"
}
